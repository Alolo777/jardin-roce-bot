# ════════════════════════════════════════════════════════════════
# Supabase
# ════════════════════════════════════════════════════════════════
# Ejecuta las migraciones `supabase_migration_*.sql` en tu proyecto
# antes de iniciar el bot.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ════════════════════════════════════════════════════════════════
# GitHub Models (cerebro IA principal) — lib/ai.ts
# ════════════════════════════════════════════════════════════════
# Los tokens de GitHub Models (https://models.inference.ai.azure.com)
# se obtienen en: https://github.com/settings/tokens (fine-grained)
# con permiso de "Microsoft Copilot".
GITHUB_TOKEN=your-github-token
GITHUB_MODEL=gpt-4o-mini
GITHUB_REVIEW_MODEL=gpt-4o-mini
GITHUB_VISION_TOKEN=your-github-vision-token

# ════════════════════════════════════════════════════════════════
# Gemini Fallback (opcional) — lib/ai.ts
# ════════════════════════════════════════════════════════════════
# Se usa solo si GitHub Models falla. Obtenlo en https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# ════════════════════════════════════════════════════════════════
# IA1 / IA2 — notification-engine (order.reconstructor / order.auditor)
# ════════════════════════════════════════════════════════════════
IA1_TOKEN=your-ia1-token
IA1_MODEL=gpt-4o-mini
IA1_BASE_URL=https://models.inference.ai.azure.com
IA2_TOKEN=your-ia2-token
IA2_MODEL=gpt-4o
IA2_BASE_URL=https://models.inference.ai.azure.com

# ════════════════════════════════════════════════════════════════
# Telegram (panel operativo / notificaciones)
# ════════════════════════════════════════════════════════════════
# Crea un bot con @BotFather y pega el token. TELEGRAM_CHAT_ID son
# los IDs de los chats (separados por coma) que recibirán alertas.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=chat_id_1,chat_id_2

# ════════════════════════════════════════════════════════════════
# Google Sheets (respaldo de pedidos) — lib/googleSheets.ts
# ════════════════════════════════════════════════════════════════
GOOGLE_SHEET_ID=your-sheet-id
GOOGLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ════════════════════════════════════════════════════════════════
# Admin Dashboard
# ════════════════════════════════════════════════════════════════
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-password

# ════════════════════════════════════════════════════════════════
# Next.js
# ════════════════════════════════════════════════════════════════
NEXTAUTH_SECRET=your-nextauth-secret

# ════════════════════════════════════════════════════════════════
# WhatsApp (Baileys) — bot.ts
# ════════════════════════════════════════════════════════════════
# Carpeta donde se guarda la sesión de WhatsApp. Si se borra, hay que
# escanear QR de nuevo. (Opcional: por defecto './.baileys_auth')
# BAILEYS_DATA_PATH=./.baileys_auth

# ════════════════════════════════════════════════════════════════
# VM / Servidor
# ════════════════════════════════════════════════════════════════
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
BOT_PORT=10000
PORT=3000
NODE_OPTIONS=--max-old-space-size=512
