# ════════════════════════════════════════════════════════════════
# Supabase
# ════════════════════════════════════════════════════════════════
# Ejecuta las migraciones `supabase_migration_*.sql` en tu proyecto
# antes de iniciar el bot.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ════════════════════════════════════════════════════════════════
# Gemini (cerebro IA principal) — lib/ai.ts
# ════════════════════════════════════════════════════════════════
# Gemini es el proveedor primario desde la v2.x (GitHub Models fue
# retirado el 2026-07-30). Obtén la key en https://aistudio.google.com
# IMPORTANTE (verificado 2026-08-03): el free tier de gemini-2.5-flash
# fue recortado a ~20 peticiones/día (no ~1500). La opción gratuita con
# mejor cuota es gemini-2.5-flash-lite (~15 RPM / ~1,000 RPD).
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# ════════════════════════════════════════════════════════════════
# Proveedores OpenAI-compatibles (fallback en cadena) — lib/ai.ts
# ════════════════════════════════════════════════════════════════
# Si Gemini falla por cuota (429), el bot recorre automáticamente la
# cadena OpenRouter → Groq → Cerebras → GitHub. CADA proveedor tiene su
# propia cuota diaria independiente: repartir tareas entre varios
# multiplica la capacidad total. Todos son opcionales; basta con dejar
# configurada la API key del proveedor deseado.
#
# OpenRouter (https://openrouter.ai — sin tarjeta): 20 RPM / 50 RPD free
# (1000 RPD tras comprar $10 de créditos). Modelo por defecto: openrouter/free.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
#
# Groq (https://console.groq.com — sin tarjeta): 30 RPM / 1,000 RPD free.
# Sin soporte de visión. Modelo por defecto: llama-3.3-70b-versatile.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
#
# Cerebras (https://cloud.cerebras.ai — sin tarjeta): ~1M tokens/día free.
# Sin soporte de visión. Modelo por defecto: llama-3.3-70b.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
#
# GitHub Models (RETIRADO 2026-07-30) — último respaldo, no funcional.
# GITHUB_TOKEN=your-github-token
# GITHUB_MODEL=gpt-4o-mini
# GITHUB_VISION_TOKEN=your-github-vision-token

# ════════════════════════════════════════════════════════════════
# IA1 / IA2 — notification-engine (order.reconstructor / order.auditor)
# ════════════════════════════════════════════════════════════════
# Módulos sin uso activo (no se importan en el flujo actual). Los
# valores por defecto apuntan a GitHub Models (retirado).
# IA1_TOKEN=your-ia1-token
# IA1_MODEL=gpt-4o-mini
# IA1_BASE_URL=https://models.inference.ai.azure.com
# IA2_TOKEN=your-ia2-token
# IA2_MODEL=gpt-4o
# IA2_BASE_URL=https://models.inference.ai.azure.com

# ════════════════════════════════════════════════════════════════
# Telegram (panel operativo / notificaciones)
# ════════════════════════════════════════════════════════════════
# Crea un bot con @BotFather y pega el token. TELEGRAM_CHAT_ID son
# los IDs de los chats (separados por coma) que recibirán alertas.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=chat_id_1,chat_id_2

# ════════════════════════════════════════════════════════════════
# Google Sheets (respaldo de pedidos) — lib/googleSheets.ts
# ════════════════════════════════════════════════════════════════
GOOGLE_SHEET_ID=your-sheet-id
GOOGLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ════════════════════════════════════════════════════════════════
# Admin Dashboard
# ════════════════════════════════════════════════════════════════
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-password

# ════════════════════════════════════════════════════════════════
# Next.js
# ════════════════════════════════════════════════════════════════
NEXTAUTH_SECRET=your-nextauth-secret

# ════════════════════════════════════════════════════════════════
# WhatsApp (Baileys) — bot.ts
# ════════════════════════════════════════════════════════════════
# Carpeta donde se guarda la sesión de WhatsApp. Si se borra, hay que
# escanear QR de nuevo. (Opcional: por defecto './.baileys_auth')
# BAILEYS_DATA_PATH=./.baileys_auth

# ════════════════════════════════════════════════════════════════
# VM / Servidor
# ════════════════════════════════════════════════════════════════
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
BOT_PORT=10000
PORT=3000
NODE_OPTIONS=--max-old-space-size=512
