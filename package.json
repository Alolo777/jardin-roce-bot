{
  "name": "floreria-agent-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-local.mjs",
    "build:local": "node scripts/build-local.mjs",
    "test:flows": "node tests/conversation-flows.test.mjs",
    "test:wire": "tsx --env-file=.env.test tests/event-wire-flow.test.mts",
    "test:horario": "tsx --env-file=.env.test tests/horario.test.mts",
    "test:nombre": "tsx --env-file=.env.test tests/nombre.test.mts",
    "test:validator": "tsx --env-file=.env.test tests/response-validator.test.mts",
    "test:inventario": "tsx --env-file=.env.test tests/inventario.test.mts",
    "test:reclamaciones": "tsx --env-file=.env.test tests/reclamaciones.test.mts",
    "test:telefono": "tsx --env-file=.env.test tests/telefono.test.mts",
    "test:precio": "tsx --env-file=.env.test tests/precio.test.mts",
    "test:template": "tsx --env-file=.env.test tests/template-payment.test.mts",
    "test:novedades": "tsx --env-file=.env.test tests/novedades.test.mts",
    "test:poda": "tsx --env-file=.env.test tests/poda.test.mts",
    "test:admin-commands": "tsx --env-file=.env.test tests/admin-commands.test.mts",
    "check:apis": "tsx --env-file=.env.local scripts/check-apis.mts",
    "start": "next start",
    "bot": "tsx --env-file=.env.local bot.ts",
    "bot:prod": "NODE_OPTIONS='--max-old-space-size=512' tsx --env-file=.env.local bot.ts",
    "bot:dev": "tsx watch --env-file=.env.local bot.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.0",
    "@google/generative-ai": "^0.24.1",
